// =============================================================================
// Arckium Tickets — Backend CI/CD
// NestJS + MongoDB
//
// Jenkins Job:
//   Pipeline from SCM
//   Script Path = backend/Jenkinsfile
//
// Environnement Jenkins:
//   - Node.js installé sur la VM
//   - npm installé sur la VM
//   - Docker installé sur la VM
//   - Docker Compose installé sur la VM
//   - SonarQube accessible (SONAR_HOST_URL)
//
// Credentials Jenkins:
//   - docker-registry-creds
//   - ssh-deploy-key
//   - sonar-token (Secret text)
// =============================================================================

pipeline {

    agent any

    // =========================================================================
    // OPTIONS
    // =========================================================================

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    // =========================================================================
    // PARAMETERS
    // =========================================================================

    parameters {

        choice(
            name: 'DEPLOY_ENV',
            choices: [
                'none',
                'staging',
                'production'
            ],
            description: 'Environnement de déploiement. none = CI uniquement'
        )

        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Ignorer les tests unitaires'
        )

        booleanParam(
            name: 'SKIP_SONAR',
            defaultValue: false,
            description: 'Ignorer l analyse SonarQube'
        )

        booleanParam(
            name: 'SKIP_DOCKER',
            defaultValue: false,
            description: 'Ignorer le build et le push Docker'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Tag Docker personnalisé. Vide = BUILD_NUMBER + Git SHA'
        )
    }

    // =========================================================================
    // ENVIRONMENT
    // =========================================================================

    environment {

        // ---------------------------------------------------------------------
        // Docker
        // ---------------------------------------------------------------------

        DOCKER_REGISTRY = 'docker.io'

        DOCKER_NAMESPACE = 'feresadouani10'

        IMAGE_NAME = "${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/tickets-backend"

        DOCKER_CREDENTIALS = 'docker-registry-creds'

        // ---------------------------------------------------------------------
        // SSH
        // ---------------------------------------------------------------------

        SSH_CREDENTIALS = 'ssh-deploy-key'

        // ---------------------------------------------------------------------
        // Deployment
        // ---------------------------------------------------------------------

        STAGING_HOST = 'staging.arckium.local'

        PROD_HOST = 'prod.arckium.local'

        DEPLOY_USER = 'deploy'

        DEPLOY_PATH = '/opt/arckium-tickets'

        // ---------------------------------------------------------------------
        // Project
        // ---------------------------------------------------------------------

        PROJECT_DIR = 'backend'

        // ---------------------------------------------------------------------
        // SonarQube (credential secret text: sonar-token)
        // ---------------------------------------------------------------------

        SONAR_HOST_URL = 'http://192.168.56.10:9000'
        SONAR_CREDENTIALS = 'sonar-token'
        SONAR_PROJECT_KEY = 'arckium-tickets-backend'
    }

    // =========================================================================
    // STAGES
    // =========================================================================

    stages {

        // =====================================================================
        // Environment
        // =====================================================================

        stage('Environment') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "Environment"
                    echo "=========================================="

                    echo ""
                    echo "Node.js:"
                    node --version

                    echo ""
                    echo "npm:"
                    npm --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Docker Compose:"
                    docker compose version

                    echo ""
                    echo "Jenkins user:"
                    whoami

                    echo ""
                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "=========================================="
                '''
            }
        }

        // =====================================================================
        // Checkout
        // =====================================================================

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.EFFECTIVE_TAG = params.IMAGE_TAG?.trim()
                        ? params.IMAGE_TAG.trim()
                        : "${env.BUILD_NUMBER}-${env.GIT_SHA}"

                    echo "=========================================="
                    echo "Backend build"
                    echo "=========================================="
                    echo "Git SHA      : ${env.GIT_SHA}"
                    echo "Docker tag   : ${env.EFFECTIVE_TAG}"
                    echo "Deploy env   : ${params.DEPLOY_ENV}"
                    echo "=========================================="
                }
            }
        }

        // =====================================================================
        // Install
        // =====================================================================

        stage('Install') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Installing backend dependencies..."

                        npm ci
                    '''
                }
            }
        }

        // =====================================================================
        // Lint
        // =====================================================================

        stage('Lint') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running ESLint..."

                        npm run lint
                    '''
                }
            }
        }

        // =====================================================================
        // Test
        // =====================================================================

        stage('Test') {

            when {

                expression {
                    return !params.SKIP_TESTS
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running NestJS unit tests with coverage..."

                        npm run test -- \
                            --ci \
                            --coverage \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=cobertura
                    '''
                }
            }

            post {

                always {

                    dir("${PROJECT_DIR}") {

                        junit(
                            allowEmptyResults: true,
                            testResults: 'junit.xml'
                        )

                        archiveArtifacts(
                            artifacts: 'coverage/**,junit.xml',
                            fingerprint: true,
                            allowEmptyArchive: true
                        )
                    }
                }
            }
        }

        // =====================================================================
        // SonarQube Analysis
        // =====================================================================

        stage('SonarQube Analysis') {

            when {

                expression {
                    return !params.SKIP_SONAR
                }
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: "${SONAR_CREDENTIALS}",
                        variable: 'SONAR_TOKEN'
                    )
                ]) {

                    dir("${PROJECT_DIR}") {

                        sh """
                            set -e

                            echo "Running SonarQube analysis..."

                            npx --yes sonarqube-scanner \\
                                -Dsonar.host.url=${SONAR_HOST_URL} \\
                                -Dsonar.token=\$SONAR_TOKEN \\
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                                -Dsonar.sources=src \\
                                -Dsonar.tests=src \\
                                -Dsonar.test.inclusions=**/*.spec.ts \\
                                -Dsonar.exclusions=**/*.spec.ts,**/main.ts,**/*.module.ts \\
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \\
                                -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info
                        """
                    }
                }
            }
        }

        // =====================================================================
        // Build
        // =====================================================================

        stage('Build') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Building NestJS application..."

                        npm run build
                    '''
                }
            }

            post {

                success {

                    archiveArtifacts(
                        artifacts: 'backend/dist/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // =====================================================================
        // Security Audit
        // =====================================================================

        stage('Security Audit') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running npm security audit..."

                        npm audit --audit-level=high || true
                    '''
                }
            }
        }

        // =====================================================================
        // Docker Build & Push
        // =====================================================================

        stage('Docker Build & Push') {

            when {

                allOf {

                    expression {
                        return !params.SKIP_DOCKER
                    }

                    anyOf {

                        branch 'main'

                        branch 'master'

                        branch 'develop'

                        expression {
                            return params.DEPLOY_ENV != 'none'
                        }
                    }
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        set -e

                        echo "=========================================="
                        echo "Docker Build"
                        echo "=========================================="

                        docker build \\
                            -t ${IMAGE_NAME}:${EFFECTIVE_TAG} \\
                            -t ${IMAGE_NAME}:latest \\
                            -f ${PROJECT_DIR}/Dockerfile \\
                            ${PROJECT_DIR}

                        echo "Built: ${IMAGE_NAME}:${EFFECTIVE_TAG}"

                        echo "=========================================="
                        echo "Docker Push"
                        echo "=========================================="

                        echo "\$DOCKER_PASS" | docker login \\
                            -u "\$DOCKER_USER" \\
                            --password-stdin \\
                            ${DOCKER_REGISTRY}

                        docker push ${IMAGE_NAME}:${EFFECTIVE_TAG}
                        docker push ${IMAGE_NAME}:latest

                        docker logout ${DOCKER_REGISTRY} || true
                    """
                }
            }
        }

        // =====================================================================
        // Deploy Staging
        // =====================================================================

        stage('Deploy Staging') {

            when {

                expression {
                    return params.DEPLOY_ENV == 'staging'
                }
            }

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDENTIALS}",
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {

                    sh """
                        set -e

                        ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no \\
                            ${DEPLOY_USER}@${STAGING_HOST} '
                                set -e

                                echo "======================================"
                                echo "Deploying backend to STAGING"
                                echo "======================================"

                                cd ${DEPLOY_PATH}

                                export BACKEND_IMAGE=${IMAGE_NAME}:${EFFECTIVE_TAG}

                                echo "Backend image:"
                                echo \$BACKEND_IMAGE

                                docker compose pull backend

                                docker compose up -d \\
                                    --remove-orphans \\
                                    backend

                                echo "Backend status:"

                                docker compose ps backend
                            '
                    """
                }
            }
        }

        // =====================================================================
        // Deploy Production
        // =====================================================================

        stage('Deploy Production') {

            when {

                expression {
                    return params.DEPLOY_ENV == 'production'
                }
            }

            steps {

                input(
                    message: "Deploy backend ${EFFECTIVE_TAG} to PRODUCTION?",
                    ok: 'Deploy'
                )

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: "${SSH_CREDENTIALS}",
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {

                    sh """
                        set -e

                        ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no \\
                            ${DEPLOY_USER}@${PROD_HOST} '
                                set -e

                                echo "======================================"
                                echo "Deploying backend to PRODUCTION"
                                echo "======================================"

                                cd ${DEPLOY_PATH}

                                export BACKEND_IMAGE=${IMAGE_NAME}:${EFFECTIVE_TAG}

                                echo "Backend image:"
                                echo \$BACKEND_IMAGE

                                docker compose pull backend

                                docker compose up -d \\
                                    --remove-orphans \\
                                    backend

                                echo "Backend status:"

                                docker compose ps backend
                            '
                    """
                }
            }
        }
    }

    // =========================================================================
    // POST ACTIONS
    // =========================================================================

    post {

        success {

            echo """
            ==========================================
            Backend pipeline SUCCESS
            ==========================================

            Git SHA    : ${env.GIT_SHA}
            Docker tag : ${env.EFFECTIVE_TAG}
            Deploy env : ${params.DEPLOY_ENV}

            ==========================================
            """
        }

        failure {

            echo """
            ==========================================
            Backend pipeline FAILED
            ==========================================
            """
        }

        always {

            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
    }
}
