// =============================================================================
// Arckium Tickets — Backend CI/CD
// NestJS + MongoDB
//
// Jenkins Job:
//   Pipeline from SCM
//   Script Path = backend/Jenkinsfile
//
// Environnement Jenkins:
//   - Node.js, npm, Docker, Docker Compose, kubectl sur la VM Jenkins
//   - SonarQube accessible (SONAR_HOST_URL)
//   - Cluster Kubernetes accessible (kubeconfig sur l agent)
//
// Credentials Jenkins:
//   - docker-registry-creds
//   - sonar-token (Secret text)
//
// Déploiement : Docker Compose et/ou Kubernetes (paramètres)
// =============================================================================

pipeline {

    agent any

    // =========================================================================
    // OPTIONS
    // =========================================================================

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    // =========================================================================
    // PARAMETERS
    // =========================================================================

    parameters {

        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Ignorer les tests unitaires'
        )

        booleanParam(
            name: 'SKIP_SONAR',
            defaultValue: false,
            description: 'Ignorer l analyse SonarQube'
        )

        booleanParam(
            name: 'SKIP_DOCKER',
            defaultValue: false,
            description: 'Ignorer le build / push Docker'
        )

        booleanParam(
            name: 'DOCKER_DEPLOY',
            defaultValue: false,
            description: 'Deployer via docker compose sur la VM Jenkins'
        )

        booleanParam(
            name: 'K8S_DEPLOY',
            defaultValue: true,
            description: 'Deployer sur Kubernetes (kubectl apply + set image)'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Tag Docker personnalisé. Vide = BUILD_NUMBER + Git SHA'
        )
    }

    // =========================================================================
    // ENVIRONMENT
    // =========================================================================

    environment {

        DOCKER_REGISTRY = 'docker.io'
        DOCKER_NAMESPACE = 'feresadouani10'
        IMAGE_NAME = "${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/tickets-backend"
        DOCKER_CREDENTIALS = 'docker-registry-creds'

        PROJECT_DIR = 'backend'
        K8S_DIR = 'k8s'
        K8S_NAMESPACE = 'arckium'

        SONAR_HOST_URL = 'http://192.168.56.10:9000'
        SONAR_CREDENTIALS = 'sonar-token'
        SONAR_PROJECT_KEY = 'arckium-tickets-backend'
    }

    // =========================================================================
    // STAGES
    // =========================================================================

    stages {

        // =====================================================================
        // Environment
        // =====================================================================

        stage('Environment') {

            steps {

                sh '''
                    echo "=========================================="
                    echo "Environment"
                    echo "=========================================="

                    echo ""
                    echo "Node.js:"
                    node --version

                    echo ""
                    echo "npm:"
                    npm --version

                    echo ""
                    echo "Docker:"
                    docker --version

                    echo ""
                    echo "Docker Compose:"
                    docker compose version

                    echo ""
                    echo "kubectl:"
                    kubectl version --client --short || kubectl version --client

                    echo ""
                    echo "Jenkins user:"
                    whoami

                    echo ""
                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "=========================================="
                '''
            }
        }

        // =====================================================================
        // Checkout
        // =====================================================================

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.EFFECTIVE_TAG = params.IMAGE_TAG?.trim()
                        ? params.IMAGE_TAG.trim()
                        : "${env.BUILD_NUMBER}-${env.GIT_SHA}"

                    echo "=========================================="
                    echo "Backend build"
                    echo "=========================================="
                    echo "Git SHA        : ${env.GIT_SHA}"
                    echo "Docker tag     : ${env.EFFECTIVE_TAG}"
                    echo "Docker deploy  : ${params.DOCKER_DEPLOY}"
                    echo "K8s deploy     : ${params.K8S_DEPLOY}"
                    echo "=========================================="
                }
            }
        }

        // =====================================================================
        // Install
        // =====================================================================

        stage('Install') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Installing backend dependencies..."

                        npm ci
                    '''
                }
            }
        }

        // =====================================================================
        // Lint
        // =====================================================================

        stage('Lint') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running ESLint..."

                        npm run lint
                    '''
                }
            }
        }

        // =====================================================================
        // Test
        // =====================================================================

        stage('Test') {

            when {

                expression {
                    return !params.SKIP_TESTS
                }
            }

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running NestJS unit tests with coverage..."

                        npm run test -- \
                            --ci \
                            --coverage \
                            --coverageReporters=lcov \
                            --coverageReporters=text \
                            --coverageReporters=cobertura
                    '''
                }
            }

            post {

                always {

                    dir("${PROJECT_DIR}") {

                        junit(
                            allowEmptyResults: true,
                            testResults: 'junit.xml'
                        )

                        archiveArtifacts(
                            artifacts: 'coverage/**,junit.xml',
                            fingerprint: true,
                            allowEmptyArchive: true
                        )
                    }
                }
            }
        }

        // =====================================================================
        // SonarQube Analysis
        // =====================================================================

        stage('SonarQube Analysis') {

            when {

                expression {
                    return !params.SKIP_SONAR
                }
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: "${SONAR_CREDENTIALS}",
                        variable: 'SONAR_TOKEN'
                    )
                ]) {

                    dir("${PROJECT_DIR}") {

                        sh """
                            set -e

                            echo "Running SonarQube analysis..."

                            npx --yes sonarqube-scanner \\
                                -Dsonar.host.url=${SONAR_HOST_URL} \\
                                -Dsonar.login=\$SONAR_TOKEN \\
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                                -Dsonar.sources=src \\
                                -Dsonar.tests=src \\
                                -Dsonar.test.inclusions=**/*.spec.ts \\
                                -Dsonar.exclusions=**/*.spec.ts,**/main.ts,**/*.module.ts \\
                                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \\
                                -Dsonar.typescript.lcov.reportPaths=coverage/lcov.info
                        """
                    }
                }
            }
        }

        // =====================================================================
        // Build
        // =====================================================================

        stage('Build') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Building NestJS application..."

                        npm run build
                    '''
                }
            }

            post {

                success {

                    archiveArtifacts(
                        artifacts: 'backend/dist/**',
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // =====================================================================
        // Security Audit
        // =====================================================================

        stage('Security Audit') {

            steps {

                dir("${PROJECT_DIR}") {

                    sh '''
                        echo "Running npm security audit..."

                        npm audit --audit-level=high || true
                    '''
                }
            }
        }

        // =====================================================================
        // Docker Build & Push
        // =====================================================================

        stage('Docker Build & Push') {

            when {
                expression {
                    return !params.SKIP_DOCKER
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: "${DOCKER_CREDENTIALS}",
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh """
                        set -e

                        echo "=========================================="
                        echo "Docker Build"
                        echo "=========================================="

                        docker build \\
                            -t ${IMAGE_NAME}:${EFFECTIVE_TAG} \\
                            -t ${IMAGE_NAME}:latest \\
                            -f ${PROJECT_DIR}/Dockerfile \\
                            ${PROJECT_DIR}

                        echo "Built: ${IMAGE_NAME}:${EFFECTIVE_TAG}"

                        echo "=========================================="
                        echo "Docker Push"
                        echo "=========================================="

                        echo "\$DOCKER_PASS" | docker login \\
                            -u "\$DOCKER_USER" \\
                            --password-stdin \\
                            ${DOCKER_REGISTRY}

                        docker push ${IMAGE_NAME}:${EFFECTIVE_TAG}
                        docker push ${IMAGE_NAME}:latest

                        docker logout ${DOCKER_REGISTRY} || true
                    """
                }
            }
        }

        // =====================================================================
        // Deploy (Docker Compose local — pas de SSH)
        // =====================================================================

        stage('Deploy Docker') {

            when {
                allOf {
                    expression { return !params.SKIP_DOCKER }
                    expression { return params.DOCKER_DEPLOY }
                }
            }

            steps {

                sh """
                    set -e

                    echo "=========================================="
                    echo "Deploy backend with Docker Compose"
                    echo "=========================================="

                    export BACKEND_IMAGE=${IMAGE_NAME}:${EFFECTIVE_TAG}

                    echo "Image: \$BACKEND_IMAGE"

                    docker compose -f docker-compose.yml up -d --remove-orphans mongo backend
                    docker compose -f docker-compose.yml ps mongo backend
                """
            }
        }

        // =====================================================================
        // Deploy Kubernetes
        // =====================================================================

        stage('Deploy Kubernetes') {

            when {
                allOf {
                    expression { return !params.SKIP_DOCKER }
                    expression { return params.K8S_DEPLOY }
                }
            }

            steps {

                sh """
                    set -e

                    echo "=========================================="
                    echo "Deploy backend on Kubernetes"
                    echo "=========================================="

                    kubectl apply -f ${K8S_DIR}/namespace.yaml
                    kubectl apply -f ${K8S_DIR}/backend-configmap.yaml
                    kubectl apply -f ${K8S_DIR}/backend-secret.yaml
                    kubectl apply -f ${K8S_DIR}/backend-deployment.yaml
                    kubectl apply -f ${K8S_DIR}/backend-service.yaml

                    kubectl set image deployment/tickets-backend \\
                        backend=${IMAGE_NAME}:${EFFECTIVE_TAG} \\
                        -n ${K8S_NAMESPACE}

                    kubectl rollout status deployment/tickets-backend \\
                        -n ${K8S_NAMESPACE} \\
                        --timeout=180s

                    echo ""
                    echo "Pods / Services backend:"
                    kubectl get pods,svc -n ${K8S_NAMESPACE} -l app=tickets-backend
                """
            }
        }
    }

    // =========================================================================
    // POST ACTIONS
    // =========================================================================

    post {

        success {

            echo """
            ==========================================
            Backend pipeline SUCCESS
            ==========================================

            Git SHA       : ${env.GIT_SHA}
            Docker tag    : ${env.EFFECTIVE_TAG}
            Docker deploy : ${params.DOCKER_DEPLOY}
            K8s deploy    : ${params.K8S_DEPLOY}

            ==========================================
            """
        }

        failure {

            echo """
            ==========================================
            Backend pipeline FAILED
            ==========================================
            """
        }

        always {

            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
    }
}
